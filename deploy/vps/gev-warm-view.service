[Unit]
Description=Surplomb — pay the cities' cold Overpass boxes so no reader does
After=network-online.target

[Service]
Type=oneshot
# Against the CONTAINER, not the public URL. Cloudflare caps /api at 30
# requests per 10 s per IP, and there is nothing at the edge this needs to
# touch: the cache being warmed is the proxy's own disk cache, inside.
#
# The host's node, not the container's: the script imports only local modules
# and no node_modules, so it needs nothing the container has.
ExecStart=/usr/bin/node /opt/gev/src/scripts/warm-road-cells.mjs --url http://localhost:4173
# Thirty cells, ten seconds apart, each allowed up to 120 s — the script paces
# itself ON PURPOSE (overpass-api.de escalates to refusal under a burst, and a
# warmer is the most burst-shaped traffic this site produces). Worst case is
# ~15 min; 30 is the point past which something is stuck rather than slow.
# The script gives up on its own after 3 consecutive failures, so this ceiling
# is a backstop, not the normal exit.
TimeoutStartSec=1800
