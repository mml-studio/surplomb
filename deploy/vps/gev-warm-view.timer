[Unit]
Description=Warm the ten cities' Overpass road cells once a week

[Timer]
# The proxy holds Overpass answers for 30 DAYS, so weekly is now four chances
# to land inside the window rather than one — which is the point: a single run
# refused by a throttled upstream no longer leaves a month of cold cells. Still
# weekly and not daily, because each run is thirty real upstream requests and
# the host that serves them is free and shared.
OnCalendar=Mon *-*-* 04:17:00
# The first boot after a deploy is also a cold cache; do not wait until Monday.
OnBootSec=10min
# Missed while the machine was off (or the container was rebuilding) is the
# normal case for a weekly timer, and the run costs two requests.
Persistent=true
AccuracySec=1min
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
